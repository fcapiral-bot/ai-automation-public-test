#!/usr/bin/env bash
# Fake `gh` for tests. Serves canned REST responses from $FAKE_GH_DIR/<slug>.json, records every call
# in calls.log and any non-GET in writes.log. Slugs listed in fail.txt answer HTTP 500 (exit 1).
set -uo pipefail
dir=${FAKE_GH_DIR:?}
echo "$*" >> "$dir/calls.log"
[[ ${1:-} == api ]] || { echo "unsupported: $*" >&2; exit 2; }
shift
method=GET; filter=; endpoint=; fields=
while (($#)); do
  case $1 in
    --paginate) ;;
    --jq) filter=$2; shift ;;
    -X) method=$2; shift ;;
    -H) shift ;;
    -f | -F) fields="$fields $2"; shift ;;
    *) endpoint=$1 ;;
  esac
  shift
done
if [[ $method != GET ]]; then
  if [[ -f $dir/fail_writes ]]; then echo "HTTP 403" >&2; exit 1; fi
  n=$(($(wc -l < "$dir/writes.log" 2>/dev/null || echo 0) + 1))
  echo "$method $endpoint$fields" >> "$dir/writes.log"
  for kv in $fields; do [[ $kv == body=@* ]] && cp "${kv#body=@}" "$dir/body-$n.txt"; done
  exit 0
fi
slug=$(printf '%s' "$endpoint" | sed -E 's#^repos/[^/]+/[^/]+/##; s#\?.*$##; s#[0-9a-f]{40}#SHA#g; s#/#_#g')
if [[ -f $dir/fail.txt ]] && grep -qx "$slug" "$dir/fail.txt"; then echo "HTTP 500" >&2; exit 1; fi
file=$dir/$slug.json
[[ -f $file ]] || { echo "HTTP 404 $slug" >&2; exit 1; }
if [[ -n $filter ]]; then
  # like the real gh: strings print raw (no quotes), everything else as compact JSON
  jq -c "$filter" "$file" | while IFS= read -r line; do
    if [[ $line == \"* ]]; then jq -r . <<<"$line"; else printf '%s\n' "$line"; fi
  done
else cat "$file"; fi
